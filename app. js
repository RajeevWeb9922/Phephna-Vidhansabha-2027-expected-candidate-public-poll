  { id: 3, name: "केशरी नन्द त्रिपाठी", info: "पूर्व चेयरमैन चितबड़ागांव नपा — बसपा" },
  { id: 4, name: "बंशीधर यादव", info: "ब्लॉक प्रमुख प्रतिनिधि सोहांव — सपा" },
  { id: 5, name: "उपेन्द्र तिवारी", info: "पूर्व मंत्री — भाजपा" },
